# ============================================================
# Plantilla de variables de entorno del taller
# Copia este archivo a `.env` y ajusta los valores si es necesario.
# docker-compose.yml las inyecta al contenedor vía `environment`.
# El archivo `.env` real está en .gitignore y NO se commitea.
# ============================================================

# --- API REST (DummyJSON) ---
API_BASE_URL=https://dummyjson.com
API_TIMEOUT_MS=10000

# --- Formulario web (The Internet /login) ---
WEB_BASE_URL=https://the-internet.herokuapp.com
WEB_LOAD_TIMEOUT_MS=10000

# --- Credenciales sintéticas del formulario (datos de prueba, no reales) ---
VALID_USERNAME=tomsmith
VALID_PASSWORD=SuperSecretPassword!

# --- Ejecución ---
# true = navegador sin ventana (CI/contenedor) | false = ventana visible (depuración)
HEADLESS=true
SCREENSHOTS_DIR=./evidence/screenshots

# --- Servidor Selenium ---
# Dentro de docker-compose ya apunta al servicio `chrome` de la misma red.
# Déjalo vacío para usar un Chrome local (requiere Chrome/chromedriver en el host).
SELENIUM_REMOTE_URL=http://chrome:4444/wd/hub
