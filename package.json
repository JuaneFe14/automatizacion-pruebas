{
  "name": "taller-automatizacion-pruebas",
  "version": "1.0.0",
  "description": "Scripts de prueba automatizada: API REST (Axios) y formulario web (Selenium + POM)",
  "private": true,
  "scripts": {
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "jest tests/api --verbose",
    "test:e2e": "jest tests/e2e --verbose",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "selenium-webdriver": "^4.27.0",
    "chromedriver": "^131.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  }
}
